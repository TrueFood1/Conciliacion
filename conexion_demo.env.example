# Copiá este archivo a  conexion_demo.env  y llená los valores.
# conexion_demo.env NO se sube: lo cubre el patrón `*.env` del .gitignore
# (verificado con `git check-ignore -v conexion_demo.env`).
# La API key NO se pega en el chat — solo va acá, en tu Mac.
#
# ⚠️ ESTO ES LA DEMO, NO PRODUCCIÓN. `odoo_demo.py` se niega a arrancar si la URL
# no contiene "demotruefood": la prueba de escritura no puede apuntar a prod ni
# por error de copiar/pegar.
#
# El nombre de la DB de la demo CAMBIA cuando Odoo regenera el staging (lleva un
# sufijo numérico). "database not found" = pedir el nombre actual, no es un bug.

ODOO_URL=https://demotruefood.odoo.com
ODOO_DB=
ODOO_USER=
ODOO_APIKEY=
